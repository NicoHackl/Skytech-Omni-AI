# Vorlage für den lokalen Betrieb außerhalb von Home Assistant.
# Im Add-on kommen dieselben Werte aus dem Reiter "Konfiguration"; dort wird
# nichts davon gebraucht. Diese Datei enthält nur Namen, nie echte Werte.
#
# Aktiver Anbieter: claude_sub oder gemini
AI_PROVIDER=claude_sub
# Add-on-weites Standardmodell. Leer lassen heißt: der Anbieter entscheidet.
OMNIAI_MODEL=
# Langlebiges Token des Claude-Pro/Max-Abos, erzeugt mit `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
# Alternative zum Abo: nach Verbrauch abgerechneter Anthropic-Schlüssel
ANTHROPIC_API_KEY=
# Schlüssel aus Google AI Studio
GEMINI_API_KEY=
# Port der Schnittstelle
PORT=8000
# Ausführlichkeit des Logs: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
